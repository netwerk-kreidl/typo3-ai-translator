{
    "name": "netwerk/typo3-ai-translator",
    "description": "KI-Übersetzung für TYPO3: Seiten, Inhaltselemente und Datei-Metadaten mit DeepL, OpenAI (ChatGPT) oder Anthropic (Claude) übersetzen.",
    "type": "typo3-cms-extension",
    "license": "proprietary",
    "authors": [
        {
            "name": "netwerk",
            "homepage": "https://www.netwerk.at"
        }
    ],
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.3",
        "typo3/cms-backend": "^14.3",
        "anthropic-ai/sdk": "^1.6",
        "typo3/cms-filelist": "^14.3"
    },
    "autoload": {
        "psr-4": {
            "Netwerk\\AiTranslator\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netwerk\\AiTranslator\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ai_translator",
            "web-dir": ".Build/public"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.1",
        "typo3/cms-fluid-styled-content": "^14.3",
        "typo3/cms-seo": "^14.3",
        "typo3/testing-framework": "^9.7"
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test:unit": "phpunit -c Build/phpunit/UnitTests.xml",
        "test:functional": "phpunit -c Build/phpunit/FunctionalTests.xml",
        "test": [
            "@test:unit",
            "@test:functional"
        ]
    }
}
